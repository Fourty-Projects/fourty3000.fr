# env files
# .env contient les secrets (webhook, cles Turnstile) : jamais versionne.
.env
.env*.local

# .env.example documente les variables attendues sans aucune valeur :
# il doit rester versionne.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts