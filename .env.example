# Variables d'environnement du site.
# Ce fichier est versionne et ne doit contenir AUCUN secret.
# Copiez-le en .env et renseignez les valeurs reelles.
#
#   cp .env.example .env

# URL du webhook qui recoit les messages du formulaire de contact.
# Exemples :
#   Discord  : https://discord.com/api/webhooks/000000/xxxxxxxx
#   Slack    : https://hooks.slack.com/services/T00/B00/xxxx
#   n8n      : https://votre-instance.n8n.io/webhook/contact
#   Make     : https://hook.make.com/xxxx
# Aucune valeur : le formulaire se desactive et affiche une erreur.
CONTACT_WEBHOOK_URL=

# Cles Cloudflare Turnstile (gratuit, invisible pour l'utilisateur).
# Tableau de bord -> Turnstile -> ajouter un site.
# Ces deux cles sont PUBLIQUES par nature : la verification de securite
# se fait sur le serveur, via la cle secrete.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=